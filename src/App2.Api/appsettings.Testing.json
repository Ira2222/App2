{
  "Features": {
    "Authentication": false,
    "KeyVault": false,
    "CORS": true,
    "SecurityHeaders": true,
    "RateLimiting": true,
    "OutputCaching": true,
    "RedisOutputCache": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "http://localhost:5173",
      "http://localhost:3000"
    ],
    "AllowedMethods": [ "GET", "POST" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ]
  },
  "Data": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "DataSource=:memory:"
  },
  "OpenTelemetry": {
    "Endpoint": ""
  }
}
