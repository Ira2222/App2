{
  "Hosting": {
    "Cloud": "Public"
  },
  "Features": {
    "Authentication": true,
    "CORS": false,
    "RateLimiting": true,
    "OutputCaching": true,
    "RedisOutputCache": false,
    "SecurityHeaders": true,
    "OpenTelemetry": false
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "TODO-TENANT-ID",
    "ClientId": "TODO-CLIENT-ID",
    "Audience": "api://TODO-API-APPID"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Data": {
    "Provider": "Sqlite",
    "ConnectionStrings": {
      "Sqlite": "Data Source=app2.db",
      "Postgres": "Host=localhost;Database=app2;Username=postgres;Password=postgres"
    }
  },
  "RateLimiting": {
    "Fixed": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 5
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "app2:oc:"
  },
  "OpenTelemetry": {
    "Endpoint": ""
  },
  "SecurityHeaders": {
    "Csp": {
      "Enabled": false,
      "AllowUnsafeInlineStyles": false,
      "ScriptSrc": [],
      "ConnectSrc": []
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
