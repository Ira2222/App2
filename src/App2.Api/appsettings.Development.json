{
  "Features": {
    "Authentication": false,
    "CORS": true
  },
  "Security": {
    "DevHeader": {
      "Enabled": true,
      "HeaderName": "X-Dev-User"
    }
  },
  "SecurityHeaders": {
    "Csp": {
      "Enabled": false,
      "AllowUnsafeInlineStyles": true,
      "ScriptSrc": [
        "'self'"
      ],
      "ConnectSrc": [
        "http://localhost:5080",
        "ws://localhost:5173"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
