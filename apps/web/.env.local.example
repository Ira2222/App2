# API base URL for development
# Copy to .env.local and adjust if needed
# Vite only exposes variables with VITE_ prefix via import.meta.env

# LocationForm API endpoint
# Default: http://localhost:5187 (ASP.NET Core default Kestrel port)
VITE_API_BASE_URL=http://localhost:5187

# Optional: Use HTTPS if your API runs on 5187 (Kestrel HTTPS)
# VITE_API_BASE_URL=https://localhost:7187
