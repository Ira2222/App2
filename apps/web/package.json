{
  "name": "app2-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:client": "openapi-generator-cli generate -i ../../openapi/app2.openapi.json -g typescript-fetch -o src/api --additional-properties=supportsES6=true,npmName=app2-api-client,typescriptThreePlus=true",
    "postgenerate:client": "echo 'TypeScript client generated in src/api'"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.5",
    "vite": "^7.1.12"
  }
}
